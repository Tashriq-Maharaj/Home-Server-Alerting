{
  "server": {
    "hostname": "homeserver",
    "cpu_count": 4,
    "ip_address": "192.168.0.56"
  },
  "monitoring": {
    "interval_seconds": 10,
    "stress_duration_seconds": 60,
    "recovery_duration_seconds": 60,
    "alert_cooldown_seconds": 1800
  },
  "thresholds": {
    "load": {
      "warning_1m": 3.8,
      "critical_1m": 5.5,
      "warning_5m": 3.4,
      "critical_5m": 4.5,
      "recovery_1m": 2.8,
      "recovery_5m": 2.5
    },
    "cpu": {
      "warning_percent": 85.0,
      "critical_percent": 95.0,
      "recovery_percent": 70.0
    },
    "psi": {
      "cpu_avg10_warn": 15.0,
      "cpu_avg10_crit": 35.0,
      "cpu_avg10_recovery": 5.0,
      "memory_avg10_warn": 10.0,
      "memory_avg10_crit": 25.0,
      "memory_avg10_recovery": 3.0,
      "io_avg10_warn": 15.0,
      "io_avg10_crit": 35.0,
      "io_avg10_recovery": 5.0
    },
    "memory": {
      "min_available_mb_warn": 1500,
      "min_available_mb_crit": 700,
      "min_available_percent_warn": 15.0,
      "min_available_percent_crit": 8.0,
      "recovery_available_percent": 20.0,
      "swap_percent_warn": 50.0,
      "swap_percent_crit": 80.0,
      "recovery_swap_percent": 40.0
    },
    "disk": {
      "mounts": ["/"],
      "warning_percent": 80.0,
      "critical_percent": 90.0,
      "recovery_percent": 78.0,
      "iowait_warning_percent": 15.0,
      "iowait_critical_percent": 30.0,
      "recovery_iowait_percent": 8.0
    },
    "temperature": {
      "warning_celsius": 80.0,
      "critical_celsius": 90.0,
      "recovery_celsius": 72.0
    }
  },
  "docker": {
    "enabled": true,
    "socket_path": "/var/run/docker.sock",
    "monitored_containers": [
      "prometheus",
      "grafana",
      "node-exporter",
      "node_exporter",
      "sqlserver",
      "sql-server",
      "plex",
      "plex-exporter",
      "plex_exporter",
      "portainer",
      "sql-exporter",
      "sql_exporter"
    ],
    "max_acceptable_restarts": 3
  },
  "system_errors": {
    "enabled": true,
    "check_oom_kills": true,
    "check_failed_systemd_services": true,
    "check_readonly_filesystems": true
  },
  "notifications": {
    "telegram": {
      "enabled": true
    },
    "email": {
      "enabled": false,
      "smtp_server": "smtp.gmail.com",
      "smtp_port": 587,
      "use_tls": true,
      "sender_email": "",
      "recipient_emails": []
    }
  },
  "logging": {
    "level": "INFO",
    "log_file": "/var/log/server_alerting.log",
    "max_bytes": 10485760,
    "backup_count": 3
  }
}
