# ==========================================
# Server Alerting - Environment Credentials
# ==========================================

# --- Telegram Notifier ---
# Create a bot via @BotFather and get chat ID from @userinfobot
TELEGRAM_BOT_TOKEN=your_telegram_bot_token_here
TELEGRAM_CHAT_ID=your_telegram_chat_id_here

# --- Email Notifier (Optional) ---
EMAIL_ENABLED=false
EMAIL_SMTP_SERVER=smtp.gmail.com
EMAIL_SMTP_PORT=587
EMAIL_USE_TLS=true
EMAIL_USERNAME=
EMAIL_PASSWORD=
EMAIL_SENDER=
EMAIL_RECIPIENTS=

# --- General Overrides (Optional) ---
# CONFIG_PATH=/etc/server_alerting/config.json
# LOG_LEVEL=INFO